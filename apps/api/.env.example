# XiaoCai API — copy to .env and fill real values. NEVER commit .env.

NODE_ENV=development
PORT=4000

# Neon Postgres. Keep sslmode=require.
# If Prisma/pg complains, remove &channel_binding=require from the URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Generate with: openssl rand -hex 32  (must be ≥32 chars)
JWT_SECRET="replace-with-a-long-random-string-32-chars-min"

# Comma-separated list of allowed web origins (CORS, credentials enabled)
WEB_ORIGIN="http://localhost:3000"
